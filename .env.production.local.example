# Production keys for loading the book from your computer. Copy to
# .env.production.local (git-ignored) and fill in. Never commit or paste these.
#
# Used by `pnpm db:migrate` and `pnpm load` when pointed at production:
#   set -a; source .env.production.local; set +a; pnpm db:migrate && pnpm load

# Neon: Vercel > Storage > your Neon database > .env.local tab (DATABASE_URL).
DATABASE_URL=
# Vercel > Storage > your Blob store > Settings (read-write token).
BLOB_READ_WRITE_TOKEN=
