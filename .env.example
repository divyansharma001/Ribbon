# Copy to .env and fill in. Never commit .env.

# Postgres. Local: docker compose up -d. Production: set by the Vercel + Neon integration.
DATABASE_URL=postgres://ribbon:ribbon@localhost:5433/ribbon

# Vercel Blob (private store). Needed locally only to upload book figures.
BLOB_READ_WRITE_TOKEN=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3210

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only this email may sign in.
ALLOWED_EMAIL=
YOUTUBE_API_KEY=
