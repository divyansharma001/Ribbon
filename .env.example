# Ribbon settings. Copy to .env and fill in. Never commit .env.
# Production values are set in Vercel (Project > Settings > Environment Variables).

# --- Database -----------------------------------------------------------------
# Local: `pnpm db:up` starts Postgres in Docker on port 5433.
# Production: set automatically when you add Neon from the Vercel Marketplace.
DATABASE_URL=postgres://ribbon:ribbon@localhost:5433/ribbon
# Test database used by `pnpm test` and `pnpm e2e` (wiped on every run).
TEST_DATABASE_URL=postgres://ribbon:ribbon@localhost:5433/ribbon_test

# --- Book figures (Vercel Blob, private store) -----------------------------------
# Locally: needed only to upload figures with `pnpm load`; without it, figures are
# read straight from ./content. Copy it from the Blob store's settings in Vercel.
BLOB_READ_WRITE_TOKEN=
# Production: set automatically when you connect the Blob store to the project.
BLOB_STORE_ID=

# --- Sign-in (Better Auth + Google) ------------------------------------------------
# A long random secret: run `openssl rand -base64 32`. Use a different one in production.
BETTER_AUTH_SECRET=
# The site's address. Also used for public profile links and share images.
BETTER_AUTH_URL=http://localhost:3210
# Google Cloud Console > APIs & Services > Credentials > OAuth client.
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The owner: this Google account can always sign in. Friends join with invites.
ALLOWED_EMAIL=

# --- Optional -------------------------------------------------------------------------
# Keeps the Lofi Girl live radio links fresh. Without it, built-in links are used.
YOUTUBE_API_KEY=

# --- Vercel only (not needed locally) ----------------------------------------------------
# Lets Vercel use the pnpm version pinned in package.json:
# ENABLE_EXPERIMENTAL_COREPACK=1
